---
import { Image } from 'astro:assets';
import logo from '../assets/brand/logo.png';
import Icon from './Icon.astro';
import { site, nav, whatsappLink } from '../data/site';

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => (href === '/' ? current === '/' : current === href || current.startsWith(`${href}/`));
---

<div class="topbar">
  <div class="container topbar__inner">
    <p class="topbar__note">
      <Icon name="spark" size={12} class="spark" />
      Creche · Nursery · Primary — Kajola Estate, Ibeju-Lekki, Lagos
    </p>
    <div class="topbar__links">
      <a href={`tel:${site.phones[0].tel}`}><Icon name="phone" size={14} />{site.phones[0].display}</a>
      <a class="topbar__email" href={`mailto:${site.email}`}><Icon name="mail" size={14} />{site.email}</a>
      <span class="topbar__social">
        <a href={site.social.instagram} target="_blank" rel="noopener" aria-label="Karisbridge Schools on Instagram">
          <Icon name="instagram" size={15} />
        </a>
        <a href={site.social.facebook} target="_blank" rel="noopener" aria-label="Karisbridge Schools on Facebook">
          <Icon name="facebook" size={15} />
        </a>
      </span>
    </div>
  </div>
</div>

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label="Karisbridge Schools — home">
      <Image src={logo} alt="Karisbridge Schools" width={186} densities={[1, 2]} loading="eager" fetchpriority="high" class="brand__logo" />
    </a>

    <nav class="nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={['nav__link', { 'is-active': isActive(item.href) }]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href="/admissions#enquire" class="btn btn--primary btn--sm">
        Book a visit
        <span class="btn__icon"><Icon name="arrow-up-right" size={16} /></span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <span data-menu-label>Menu</span>
        <span class="menu-toggle__lines" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu grain" id="mobile-menu" data-menu inert>
  <nav aria-label="Mobile">
    <ul class="mobile-menu__list">
      {
        nav.map((item, i) => (
          <li>
            <a href={item.href} style={`--i:${i}`} aria-current={isActive(item.href) ? 'page' : undefined}>
              <small>{String(i + 1).padStart(2, '0')}</small>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="mobile-menu__foot">
    <a href="/admissions#enquire" class="btn btn--light">
      Book a school visit
      <span class="btn__icon"><Icon name="arrow-up-right" size={18} /></span>
    </a>
    <div class="stack-sm">
      <p>{site.address.street}<br />{site.address.area}, {site.address.city}</p>
      <p><a href={`tel:${site.phones[0].tel}`}>{site.phones[0].display}</a> · <a href={`tel:${site.phones[1].tel}`}>{site.phones[1].display}</a></p>
      <p><a href={`mailto:${site.email}`}>{site.email}</a></p>
    </div>
    <div class="mobile-menu__social">
      <a class="icon-btn" href={site.social.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" size={18} /></a>
      <a class="icon-btn" href={site.social.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" size={18} /></a>
      <a class="icon-btn" href={whatsappLink()} target="_blank" rel="noopener" aria-label="WhatsApp"><Icon name="whatsapp" size={18} /></a>
    </div>
  </div>
</div>
