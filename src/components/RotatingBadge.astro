---
import Icon from './Icon.astro';

interface Props {
  size?: number;
  text?: string;
  class?: string;
  [key: string]: unknown;
}

const { size = 148, text = 'Show forth your light • Karisbridge Schools • ', class: className, ...rest } = Astro.props;
const id = `badge-path-${Math.random().toString(36).slice(2, 8)}`;
---

<div class:list={['badge-rotate', className]} style={`--badge-size:${size}px`} role="img" aria-label="Show forth your light" {...rest}>
  <svg class="badge-rotate__text" viewBox="0 0 160 160" aria-hidden="true">
    <defs>
      <path id={id} d="M80,80 m-61,0 a61,61 0 1,1 122,0 a61,61 0 1,1 -122,0"></path>
    </defs>
    <text><textPath href={`#${id}`} textLength="381" lengthAdjust="spacing">{text}</textPath></text>
  </svg>
  <span class="badge-rotate__core"><Icon name="spark" size={Math.round(size * 0.2)} class="twinkle" /></span>
</div>
