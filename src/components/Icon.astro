---
/**
 * Inline SVG icon set (24×24 grid, 1.6px strokes) so icons inherit colour
 * and never cause extra network requests.
 */
interface Props {
  name: IconName;
  size?: number;
  class?: string;
  label?: string;
  [key: string]: unknown;
}

export type IconName =
  | 'arrow-right'
  | 'arrow-up-right'
  | 'arrow-left'
  | 'phone'
  | 'mail'
  | 'pin'
  | 'clock'
  | 'instagram'
  | 'facebook'
  | 'whatsapp'
  | 'close'
  | 'plus'
  | 'check'
  | 'spark'
  | 'heart'
  | 'globe'
  | 'hand'
  | 'book'
  | 'code'
  | 'chef'
  | 'flask'
  | 'palette'
  | 'abacus'
  | 'sun'
  | 'music'
  | 'shield'
  | 'users'
  | 'calendar'
  | 'compass'
  | 'leaf'
  | 'star'
  | 'award'
  | 'expand';

const { name, size = 20, class: className, label, ...rest } = Astro.props;

const icons: Record<IconName, string> = {
