---
import Photo from './Photo.astro';
import Arc from './Arc.astro';
import type { Media } from '../data/media';

interface Props {
  eyebrow: string;
  crumb: string;
  lead?: string;
  image?: Media;
  position?: string;
}

const { eyebrow, crumb, lead, image, position } = Astro.props;
---

<section class="page-hero">
  <Arc class="page-hero__arc" />
  <div class="container page-hero__grid">
    <div class="page-hero__copy">
      <nav class="crumbs" aria-label="Breadcrumb" data-reveal="fade">
        <a href="/">Home</a>
        <span aria-hidden="true"></span>
        <span aria-current="page">{crumb}</span>
      </nav>
      <p class="eyebrow" data-reveal style="--d:1">{eyebrow}</p>
      <h1 class="t-h1" data-split><slot name="title" /></h1>
      {lead && <p class="t-lead" data-reveal style="--d:3">{lead}</p>}
      <slot name="actions" />
    </div>
    {
      image && (
        <div class="page-hero__media" data-reveal="scale" style="--d:2">
          <div class="frame arch-4x5">
            <Photo src={image.src} alt={image.alt} priority sizes="(max-width: 900px) 90vw, 460px" position={position} />
          </div>
          <slot name="media" />
        </div>
      )
    }
  </div>
</section>
