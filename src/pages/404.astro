---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Arc from '../components/Arc.astro';
import { nav } from '../data/site';
---

<Base title="Page not found" noindex>
  <section class="lost">
    <Arc class="lost__arc" spans={5} />
    <div class="container lost__inner">
      <p class="lost__code" aria-hidden="true">4<span>0</span>4</p>
      <p class="eyebrow">Page not found</p>
      <h1 class="t-h1">This bridge leads <em>nowhere</em> — yet<span class="full-stop">.</span></h1>
      <p class="t-lead t-muted">The page you were looking for may have moved. Let’s get you back on the right path.</p>
      <div class="btn-row lost__actions">
        <a href="/" class="btn btn--primary">
          Back to home
          <span class="btn__icon btn__icon--slide"><Icon name="arrow-right" size={18} /></span>
        </a>
        <a href="/contact" class="btn btn--ghost">
          Contact us
          <span class="btn__icon btn__icon--slide"><Icon name="arrow-right" size={18} /></span>
        </a>
      </div>
      <ul class="lost__links">
        {nav.slice(1).map((n) => <li><a class="text-link" href={n.href}>{n.label}</a></li>)}
      </ul>
    </div>
  </section>
</Base>

<style>
  .lost {
    position: relative;
    overflow: hidden;
    padding: clamp(64px, 9vw, 140px) 0 clamp(96px, 11vw, 170px);
    isolation: isolate;
  }

  .lost__arc {
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 6%;
    width: min(1300px, 140vw);
    transform: translateX(-50%);
    color: var(--line);
  }

  .lost__inner {
    display: grid;
    justify-items: center;
    gap: 1.6rem;
    max-width: 820px;
    text-align: center;
  }

  .lost__code {
    font-family: var(--font-display);
    font-size: clamp(6rem, 3rem + 14vw, 14rem);
    font-weight: 300;
    line-height: 0.85;
    letter-spacing: -0.06em;
    color: var(--ink);
  }

  .lost__code span {
    font-style: italic;
    color: var(--sky-ink);
  }

  .lost__actions {
    justify-content: center;
  }

  .lost__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem 1.6rem;
    margin-top: 1rem;
    font-size: 0.95rem;
  }
</style>
