---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/Icon.astro';
import Arc from '../components/Arc.astro';
import RotatingBadge from '../components/RotatingBadge.astro';
import { media } from '../data/media';
import type { Media } from '../data/media';
import { site, whatsappLink } from '../data/site';

const ribbon = [
  'Creche',
  'Nursery',
  'Primary',
  'Coding & ICT',
  'Young chefs',
  'Little scientists',
  'Art & craft',
  'World cultures',
  'Hands-on maths',
  'Character & kindness',
];

const pillars: { icon: IconName; tone: string; title: string; text: string }[] = [
  {
    icon: 'sun',
    tone: 'icon-tile--sun',
    title: 'Holistic by design',
    text: 'Head, heart and hands grow together. Strong foundations in reading, number and science sit alongside art, movement, music and real-life skills.',
  },
  {
    icon: 'heart',
    tone: 'icon-tile--red',
    title: 'Character first',
    text: '“We don’t bully. We love.” is written on our wall — and practised in every classroom. Kindness, respect and good manners are taught, modelled and celebrated.',
  },
  {
    icon: 'globe',
    tone: '',
    title: 'World-minded',
    text: 'From the flags at our gate to our around-the-world graduation, children learn they belong to a big, beautiful world — and that Lagos is a wonderful place to start.',
  },
  {
    icon: 'hand',
    tone: 'icon-tile--ink',
    title: 'Learning by doing',
    text: 'Coding on laptops, baking in chef’s hats, experimenting in lab coats. Children remember what they touch, make and discover for themselves.',
  },
];

const programmes: { key: string; stage: string; title: string; text: string; image: Media; position?: string }[] = [
  {
    key: 'creche',
    stage: 'Babies & toddlers',
    title: 'Creche',
    text: 'Gentle, loving care with rich sensory play, first words and calm, predictable routines — so the youngest members of our family feel safe from day one.',
    image: media.gradShapesHearts,
    position: '42% 50%',
  },
  {
    key: 'nursery',
    stage: 'Early years',
    title: 'Nursery',
    text: 'Play-based learning that builds early literacy and numeracy, curiosity and confidence — through stories, songs, hands-on materials and the joy of the stage.',
    image: media.gradFlowerApple,
    position: '50% 40%',
  },
  {
    key: 'primary',
    stage: 'Primary years',
    title: 'Primary',
    text: 'Strong foundations in English, mathematics and science, enriched by ICT and coding, projects and presentations — raising capable, articulate young leaders.',
    image: media.gradContinentsStage,
    position: '62% 40%',
  },
];

const discoveries: { title: string; text: string; image: Media }[] = [
  { title: 'Coding & ICT', text: 'Block-based coding and confident computer skills in our lab.', image: media.codingLab },
  { title: 'Young chefs', text: 'Measuring, mixing and tasting — maths and science in an apron.', image: media.youngChef },
  { title: 'Little scientists', text: 'Experiments that fizz, splash and sometimes get gloriously messy.', image: media.littleScientist },
  { title: 'Art & craft', text: 'Colouring, weaving and making, with patience and pride in every piece.', image: media.artColouring },
  { title: 'Hands-on maths', text: 'Counting sticks, beads and trays that make numbers real.', image: media.countingSticks },
  { title: 'World cultures', text: 'Flags, costumes, crafts and stories from every continent.', image: media.craftFans },
  { title: 'Outdoor discovery', text: 'Water play, nature and movement in the fresh air.', image: media.outdoorDiscovery },
  { title: 'Health & wellbeing', text: 'Visits and talks that teach children to care for themselves.', image: media.dentalHealthTalk },
];

const campus: { icon: IconName; title: string; text: string }[] = [
  { icon: 'sun', title: 'An entrance they never forget', text: 'Children walk into school through the smile of our ocean-themed shark mural.' },
  { icon: 'book', title: 'Bright, air-conditioned classrooms', text: 'Calm, colourful rooms set up for focus, play and small-group work.' },
  { icon: 'code', title: 'A dedicated computer lab', text: 'Laptops for coding, digital skills and early research.' },
  { icon: 'leaf', title: 'Room to run', text: 'A playground, roundabout, climbing frame and all-weather turf.' },
  { icon: 'shield', title: 'A calm, gated setting', text: 'Tucked inside Kajola Estate Phase 1, off the Lekki–Epe Expressway.' },
];

const steps = [
  { title: 'Enquire', text: 'Send us a message on WhatsApp, give us a call or complete our short enquiry form.' },
  { title: 'Visit', text: 'Tour the school, meet our teachers and see a real Karisbridge day in action.' },
  { title: 'Enrol', text: 'Complete registration, and we will help your child settle in with a warm welcome.' },
];

const socialStrip = [media.youngChef, media.handsUp, media.playCarousel, media.codingScratch, media.sortingBeads, media.welcomeBack];
---

<Base>
  <!-- ============ Hero ============ -->
  <section class="hero">
    <Arc class="hero__arc" spans={5} />
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow" data-reveal>Creche · Nursery · Primary</p>
        <h1 class="t-display hero__title" data-split>
          Where little lights learn to <em>shine</em><span class="full-stop">.</span>
        </h1>
        <p class="t-lead hero__lead" data-reveal style="--d:3">
          At Karisbridge, holistic education and excellent character go hand in hand — a joyful, world-minded start for
          children in Ibeju-Lekki, from their very first steps to their final primary year.
        </p>
        <div class="btn-row" data-reveal style="--d:4">
          <a class="btn btn--primary" href="/admissions#enquire">
            Book a school visit
            <span class="btn__icon"><Icon name="arrow-up-right" size={18} /></span>
          </a>
          <a class="btn btn--ghost" href="/academics">
            Explore programmes
            <span class="btn__icon btn__icon--slide"><Icon name="arrow-right" size={18} /></span>
          </a>
        </div>
        <ul class="hero__facts" data-reveal style="--d:5">
          <li class="chip"><Icon name="pin" size={16} /> Kajola Estate, Ibeju-Lekki</li>
          <li class="chip"><Icon name="heart" size={16} /> We don’t bully. We love.</li>
        </ul>
      </div>

      <div class="hero__media">
        <div class="hero__glow" aria-hidden="true"></div>
        <div class="hero__main frame arch-4x5" data-reveal="clip" style="--d:1">
          <Photo
            src={media.gradShapesTeacher.src}
            alt={media.gradShapesTeacher.alt}
            priority
            sizes="(max-width: 900px) 80vw, 460px"
            position="46% 50%"
          />
        </div>
        <div class="hero__circle frame circle ring" data-reveal="scale" style="--d:5">
          <Photo src={media.showForthYourLight.src} alt={media.showForthYourLight.alt} sizes="190px" />
        </div>
        <div class="hero__badge" data-reveal="scale" style="--d:7">
          <RotatingBadge size={144} />
        </div>
        <Icon name="spark" size={28} class="spark twinkle hero__spark hero__spark--a" />
        <Icon name="spark" size={16} class="spark twinkle hero__spark hero__spark--b" />
      </div>
    </div>
  </section>

  <!-- ============ Ribbon ============ -->
  <section class="ribbon grain" aria-label="Life at Karisbridge">
    <div class="marquee">
      {
        [0, 1].map((copy) => (
          <ul class="marquee__track" aria-hidden={copy === 1 ? 'true' : undefined}>
            {ribbon.map((item) => (
              <li class="ribbon__item">
                <Icon name="spark" size={16} class="spark" />
                {item}
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </section>

  <!-- ============ Welcome ============ -->
  <section class="section welcome">
    <div class="container welcome__grid">
      <div class="welcome__media">
        <div class="frame arch-3x4 welcome__arch" data-reveal="clip">
          <Photo src={media.campusFront.src} alt={media.campusFront.alt} sizes="(max-width: 900px) 80vw, 440px" position="60% 50%" />
        </div>
        <div class="frame circle ring welcome__circle" data-reveal="scale" style="--d:3">
          <Photo src={media.welcomeBack.src} alt={media.welcomeBack.alt} sizes="170px" />
        </div>
        <p class="welcome__tag" data-reveal style="--d:5">
          <Icon name="spark" size={14} class="spark" /> Our ocean-themed entrance
        </p>
      </div>

      <div class="welcome__copy">
        <p class="eyebrow" data-reveal>Welcome to Karisbridge</p>
        <h2 class="t-h2" data-split>
          <em>Karis</em> means grace. A bridge carries you somewhere new<span class="full-stop">.</span>
        </h2>
        <div class="stack" data-reveal style="--d:2">
          <p class="t-lead">
            That is exactly what we set out to be: a gracious, joyful place that carries children confidently from home
            into learning — and from learning into the wider world.
          </p>
          <p>
            Karisbridge Schools is a Creche, Nursery and Primary school in Kajola Estate, Ibeju-Lekki. Our children are
            known by name, taught with care and challenged to be their best — academically, creatively and in character.
          </p>
        </div>
        <dl class="welcome__facts" data-reveal style="--d:3">
          <div>
            <dt>Our promise</dt>
            <dd>{site.tagline}</dd>
          </div>
          <div>
            <dt>Our vision</dt>
            <dd>Shaping global citizens through holistic learning</dd>
          </div>
        </dl>
        <a href="/about" class="link-arrow" data-reveal style="--d:4">Discover our story <Icon name="arrow-right" size={18} /></a>
      </div>
    </div>
  </section>

  <!-- ============ Pillars ============ -->
  <section class="section section--cream pillars">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow" data-reveal>Why families choose us</p>
          <h2 class="t-h2" data-split>Four promises we keep, <em>every single day</em><span class="full-stop">.</span></h2>
        </div>
        <p class="t-lead t-muted" data-reveal style="--d:2">
          Great schools are built on small, faithful habits. These are ours — the things you will notice on your first visit
          and every day after.
        </p>
      </div>
      <div class="pillars__grid">
        {
          pillars.map((pillar, i) => (
            <article class="card pillar" data-reveal style={`--d:${i}`}>
              <div class="pillar__top">
                <span class:list={['icon-tile', pillar.tone]}>
                  <Icon name={pillar.icon} size={24} />
                </span>
                <span class="num">0{i + 1}</span>
              </div>
              <h3 class="t-h4">{pillar.title}</h3>
              <p class="t-muted">{pillar.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ Programmes ============ -->
  <section class="section programmes">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow" data-reveal>Our programmes</p>
        <h2 class="t-h2" data-split>A bridge for every <em>stage</em><span class="full-stop">.</span></h2>
        <p class="t-lead t-muted" data-reveal style="--d:2">
          From a baby’s first explorations to a confident primary pupil presenting on stage, each stage builds gently on the
          last.
        </p>
      </div>
      <div class="programmes__grid">
        {
          programmes.map((p, i) => (
            <a href={`/academics#${p.key}`} class="card-link programme" data-reveal style={`--d:${i}`}>
              <div class="frame arch-3x4">
                <Photo src={p.image.src} alt={p.image.alt} sizes="(max-width: 760px) 90vw, (max-width: 1100px) 45vw, 380px" position={p.position} />
              </div>
              <div class="programme__body">
                <p class="programme__stage">
                  <span class="num">0{i + 1}</span> {p.stage}
                </p>
                <h3 class="t-h2 programme__title">{p.title}</h3>
                <p class="t-muted">{p.text}</p>
                <span class="link-arrow">
                  Discover {p.title} <Icon name="arrow-right" size={18} />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ Discovery ============ -->
  <section class="section section--cream discovery">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow" data-reveal>Beyond the classroom</p>
          <h2 class="t-h2" data-split>Learning you can <em>touch</em><span class="full-stop">.</span></h2>
        </div>
        <div class="stack" data-reveal style="--d:2">
          <p class="t-lead t-muted">
            Every week is full of doing: making, building, cooking, testing and performing. It is how curiosity turns into
            understanding — and how children discover what they love.
          </p>
          <a href="/academics#enrichment" class="link-arrow">See our enrichment programme <Icon name="arrow-right" size={18} /></a>
        </div>
      </div>
      <ul class="discovery__grid">
        {
          discoveries.map((d, i) => (
            <li class="discovery__item" data-reveal style={`--d:${i % 4}`}>
              <div class="frame circle discovery__img">
                <Photo src={d.image.src} alt={d.image.alt} sizes="132px" />
              </div>
              <div>
                <h3 class="t-h4">{d.title}</h3>
                <p class="t-muted t-small">{d.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ Moments ============ -->
  <section class="section section--night moments on-dark grain">
    <Arc class="moments__arc" spans={4} />
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow" data-reveal>Moments that matter</p>
          <h2 class="t-h2" data-split>Around the world in <em>one afternoon</em><span class="full-stop">.</span></h2>
        </div>
        <div class="stack" data-reveal style="--d:2">
          <p class="t-lead">
            At our 2nd Graduation &amp; Award Ceremony, our children crossed every continent without leaving the stage — in
            costume, in song and in brilliant confidence.
          </p>
          <a href="/life" class="link-arrow">See life at Karisbridge <Icon name="arrow-right" size={18} /></a>
        </div>
      </div>

      <div class="moments__grid">
        <figure class="frame frame--zoom moments__a" data-reveal="clip">
          <Photo src={media.gradWorldLine.src} alt={media.gradWorldLine.alt} sizes="(max-width: 900px) 92vw, 720px" />
          <figcaption class="moments__cap">{media.gradWorldLine.caption}</figcaption>
        </figure>
        <figure class="frame frame--zoom moments__b" data-reveal="clip" style="--d:2">
          <Photo src={media.gradAntarctica.src} alt={media.gradAntarctica.alt} sizes="(max-width: 900px) 92vw, 500px" position="50% 40%" />
          <figcaption class="moments__cap">{media.gradAntarctica.caption}</figcaption>
        </figure>
        <figure class="frame frame--zoom moments__c" data-reveal="clip" style="--d:3">
          <Photo src={media.gradRoots.src} alt={media.gradRoots.alt} sizes="(max-width: 900px) 92vw, 500px" position="50% 58%" />
          <figcaption class="moments__cap">{media.gradRoots.caption}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- ============ Motto ============ -->
  <section class="section motto">
    <div class="container motto__inner">
      <Icon name="spark" size={34} class="spark twinkle motto__spark motto__spark--a" />
      <Icon name="spark" size={20} class="spark twinkle motto__spark motto__spark--b" />
      <Icon name="spark" size={26} class="spark twinkle motto__spark motto__spark--c" />
      <div class="frame circle ring motto__photo" data-reveal="scale">
        <Photo src={media.firstDaySigns.src} alt={media.firstDaySigns.alt} sizes="150px" />
      </div>
      <p class="eyebrow" data-reveal style="--d:1">Our motto</p>
      <h2 class="motto__title" data-split>Show forth your <em>light</em><span class="full-stop">.</span></h2>
      <p class="t-lead t-muted motto__text" data-reveal style="--d:3">
        It is written on the stars our children carry on their first day, and it is the heart of everything we do: be
        kind, be brave, be curious — and let the good in you be seen.
      </p>
    </div>
  </section>

  <!-- ============ Campus ============ -->
  <section class="section section--cream campus">
    <div class="container campus__grid">
      <div class="campus__media">
        <div class="frame campus__photo" data-reveal="clip">
          <Photo src={media.campusCourtyard.src} alt={media.campusCourtyard.alt} sizes="(max-width: 980px) 92vw, 640px" position="50% 55%" />
        </div>
        <div class="campus__pin" data-reveal style="--d:4">
          <span class="icon-tile"><Icon name="pin" size={22} /></span>
          <span>
            <strong>{site.address.street}</strong>
            <small>Ibeju-Lekki, Lagos</small>
          </span>
        </div>
      </div>
      <div class="campus__copy">
        <p class="eyebrow" data-reveal>Our campus</p>
        <h2 class="t-h2" data-split>Built for <em>wonder</em>, designed for peace of mind<span class="full-stop">.</span></h2>
        <ul class="campus__list">
          {
            campus.map((c, i) => (
              <li data-reveal style={`--d:${i + 1}`}>
                <span class="campus__icon">
                  <Icon name={c.icon} size={20} />
                </span>
                <div>
                  <h3 class="t-h4">{c.title}</h3>
                  <p class="t-muted t-small">{c.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ Admissions steps ============ -->
  <section class="section admissions-steps">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow" data-reveal>Admissions</p>
          <h2 class="t-h2" data-split>Joining Karisbridge is <em>simple</em><span class="full-stop">.</span></h2>
        </div>
        <p class="t-lead t-muted" data-reveal style="--d:2">
          We welcome enquiries for Creche, Nursery and Primary. Three friendly steps, and a team that will walk with you
          through each one.
        </p>
      </div>
      <ol class="steps">
        {
          steps.map((s, i) => (
            <li class="step" data-reveal style={`--d:${i}`}>
              <span class="step__num">0{i + 1}</span>
              <h3 class="t-h3">{s.title}</h3>
              <p class="t-muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="btn-row steps__cta" data-reveal>
        <a href="/admissions" class="btn btn--primary">
          Start your enquiry
          <span class="btn__icon"><Icon name="arrow-up-right" size={18} /></span>
        </a>
        <a href={whatsappLink('Hello Karisbridge Schools, I would like to book a school visit.')} target="_blank" rel="noopener" class="btn btn--ghost">
          Chat on WhatsApp
          <span class="btn__icon btn__icon--slide"><Icon name="whatsapp" size={18} /></span>
        </a>
        <a href={`tel:${site.phones[0].tel}`} class="link-arrow steps__call"><Icon name="phone" size={18} /> {site.phones[0].display}</a>
      </div>
    </div>
  </section>

  <!-- ============ Social strip ============ -->
  <section class="section section--tight social">
    <div class="container social__grid">
      <div class="social__copy" data-reveal>
        <p class="eyebrow">Follow our days</p>
        <h2 class="t-h3">Little moments, shared daily on <a class="text-link" href={site.social.instagram} target="_blank" rel="noopener">{site.social.instagramHandle}</a></h2>
      </div>
      <ul class="social__strip">
        {
          socialStrip.map((img, i) => (
            <li data-reveal="scale" style={`--d:${i}`}>
              <a href={site.social.instagram} target="_blank" rel="noopener" class="frame social__tile" aria-label={`${img.caption} — view on Instagram`}>
                <Photo src={img.src} alt="" sizes="180px" />
                <span class="social__hover" aria-hidden="true"><Icon name="instagram" size={22} /></span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    padding: clamp(24px, 4vw, 64px) 0 clamp(96px, 9vw, 140px);
    overflow: hidden;
    isolation: isolate;
  }

  .hero__arc {
    position: absolute;
    z-index: -1;
    top: 4%;
    left: 38%;
    width: min(1500px, 130vw);
    color: var(--line);
    -webkit-mask-image: linear-gradient(180deg, #000 30%, transparent 92%);
    mask-image: linear-gradient(180deg, #000 30%, transparent 92%);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(40px, 5vw, 80px);
    align-items: center;
  }

  .hero__copy {
    display: grid;
    gap: 1.8rem;
    justify-items: start;
  }

  .hero__title {
    max-width: 10.5ch;
  }

  .hero__lead {
    max-width: 34rem;
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 0.4rem;
  }

  .hero__media {
    position: relative;
    padding: 36px 0 44px 72px;
  }

  .hero__glow {
    position: absolute;
    z-index: -1;
    top: -4%;
    right: -14%;
    width: 92%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 40%, rgba(14, 165, 236, 0.18), rgba(242, 177, 58, 0.1) 45%, transparent 70%);
  }

  .hero__main {
    width: min(100%, 460px);
    margin-left: auto;
    box-shadow: var(--shadow-lg);
  }

  .hero__circle {
    position: absolute;
    left: 0;
    bottom: 6px;
    width: clamp(132px, 13vw, 184px);
  }

  .hero__badge {
    position: absolute;
    top: 0;
    left: 14px;
  }

  .hero__spark {
    position: absolute;
  }

  .hero__spark--a {
    top: 42%;
    right: -18px;
  }

  .hero__spark--b {
    top: 12%;
    right: 26%;
    animation-delay: 1.2s;
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__media {
      width: min(100%, 540px);
      margin-inline: auto;
      padding: 28px 0 32px 48px;
    }
    .hero__badge :global(.badge-rotate) {
      --badge-size: 112px !important;
    }
  }

  /* ---------- Ribbon ---------- */
  .ribbon {
    padding: clamp(20px, 2.4vw, 30px) 0;
    background: var(--indigo);
    color: var(--white);
  }

  .ribbon__item {
    display: inline-flex;
    align-items: center;
    gap: clamp(28px, 4vw, 56px);
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 1.1rem + 1vw, 2.1rem);
    font-style: italic;
    font-weight: 330;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .ribbon__item :global(.spark) {
    order: 2;
  }

  /* ---------- Welcome ---------- */
  .welcome__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(48px, 7vw, 120px);
    align-items: center;
  }

  .welcome__media {
    position: relative;
    padding: 0 56px 64px 0;
  }

  .welcome__arch {
    width: min(100%, 440px);
    box-shadow: var(--shadow);
  }

  .welcome__circle {
    position: absolute;
    right: 0;
    bottom: 0;
    width: clamp(128px, 12vw, 170px);
  }

