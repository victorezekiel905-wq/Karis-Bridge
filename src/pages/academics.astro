---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/Icon.astro';
import { media } from '../data/media';
import type { Media } from '../data/media';

const stages: {
  id: string;
  num: string;
  stage: string;
  title: string;
  lead: string;
  body: string;
  points: string[];
  image: Media;
  position?: string;
  moments: Media[];
}[] = [
  {
    id: 'creche',
    num: '01',
    stage: 'Babies & toddlers',
    title: 'Creche',
    lead: 'A gentle, loving first step away from home.',
    body: 'Our creche is calm, clean and full of warmth. Caregivers follow each child’s rhythm — feeding, rest, play and cuddles — while filling the day with songs, stories and sensory discovery.',
    points: [
      'Loving, attentive caregivers and calm, consistent routines',
      'Sensory play, music and movement every day',
      'First words, songs, rhymes and picture books',
      'Gentle first steps in sharing and playing together',
      'Clean, safe spaces for rest, meals and personal care',
    ],
    image: media.gradShapesHearts,
    position: '40% 50%',
    moments: [media.sortingBeads, media.playCarousel],
  },
  {
    id: 'nursery',
    num: '02',
    stage: 'Early years',
    title: 'Nursery',
    lead: 'Where play becomes purposeful learning.',
    body: 'In Nursery, children learn through doing. Hands-on materials make numbers real, stories build vocabulary, and projects — like becoming the roots, leaves and flowers of a plant — turn big ideas into unforgettable moments.',
    points: [
      'Letter sounds, early reading and confident mark-making',
      'Hands-on number work with counting sticks, beads and shapes',
      'Science and nature through play and observation',
      'Art, craft, songs, role-play and performance',
      'Growing independence, good manners and friendship',
    ],
    image: media.gradFlowerApple,
    position: '50% 38%',
    moments: [media.countingSticks, media.artColouring],
  },
  {
    id: 'primary',
    num: '03',
    stage: 'Primary years',
    title: 'Primary',
    lead: 'Strong foundations, bright horizons.',
    body: 'Primary pupils build secure skills in English, mathematics and science, then stretch them through ICT, projects and presentations. We raise articulate, curious young people who are proud of their work and kind to others.',
    points: [
      'Secure foundations in English, Mathematics and Science',
      'ICT and block-based coding in our computer lab',
      'Social studies, culture and world awareness',
      'Projects, presentations and public speaking',
      'Character, leadership and responsibility',
    ],
    image: media.gradContinentsStage,
    position: '62% 40%',
    moments: [media.codingScratch, media.handsUp],
  },
];

const principles: { icon: IconName; title: string; text: string }[] = [
  { icon: 'hand', title: 'Hands-on, every day', text: 'Children learn by making, testing and exploring — not just listening.' },
  { icon: 'heart', title: 'Known by name', text: 'Teachers know each child well: their strengths, their worries and their next step.' },
  { icon: 'users', title: 'Parents as partners', text: 'We keep families close to their child’s learning and celebrate progress together.' },
  { icon: 'award', title: 'Progress, celebrated', text: 'Award ceremonies, performances and showcases give every child a moment to shine.' },
];

const enrichment: { icon: IconName; title: string; text: string; image: Media }[] = [
  { icon: 'code', title: 'Coding & ICT', text: 'Block-based coding, typing and digital skills in our computer lab, building logic and creativity.', image: media.codingLab },
  { icon: 'chef', title: 'Young chefs', text: 'Cooking and baking sessions that teach measuring, hygiene, teamwork — and patience while it bakes.', image: media.youngChef },
  { icon: 'flask', title: 'Little scientists', text: 'Experiments with colour, water, plants and materials that make children ask “why?”', image: media.littleScientist },
  { icon: 'palette', title: 'Art & craft', text: 'Drawing, painting, colouring and weaving that build fine motor skills and self-expression.', image: media.craftFans },
  { icon: 'abacus', title: 'Hands-on maths', text: 'Montessori-inspired materials — beads, sticks and trays — that make numbers something to hold.', image: media.sortingBeads },
  { icon: 'globe', title: 'World cultures', text: 'Costumes, flags, food and stories from every continent, celebrated on stage and in class.', image: media.gradAntarctica },
  { icon: 'leaf', title: 'Outdoor discovery', text: 'Water play, nature exploration and plenty of movement on our playground and turf.', image: media.outdoorDiscovery },
  { icon: 'shield', title: 'Health & wellbeing', text: 'Talks and visits — like our dental health session — that teach children to care for themselves.', image: media.dentalHealthTalk },
];

const jump = [
  { href: '#creche', label: 'Creche' },
  { href: '#nursery', label: 'Nursery' },
  { href: '#primary', label: 'Primary' },
  { href: '#enrichment', label: 'Enrichment' },
  { href: '#summer-school', label: 'Summer School' },
];
---

<Base
  title="Academics & Programmes"
  description="Creche, Nursery and Primary programmes at Karisbridge Schools, Ibeju-Lekki — hands-on, holistic learning enriched by coding, cooking, science, art and world cultures."
  image={media.gradRoots.src}
>
  <PageHero
    crumb="Academics"
    eyebrow="Programmes & learning"
    lead="Each stage at Karisbridge builds gently on the last — from a baby’s first explorations to a confident primary pupil presenting on stage."
    image={media.gradRoots}
    position="50% 45%"
  >
    <Fragment slot="title">Learning that grows <em>with</em> your child<span class="full-stop">.</span></Fragment>
    <nav slot="actions" class="jump" aria-label="On this page" data-reveal style="--d:4">
      {jump.map((j) => <a href={j.href}>{j.label}</a>)}
    </nav>
  </PageHero>

  <!-- ============ Stages ============ -->
  <div class="stages">
    {
      stages.map((s, i) => (
        <section id={s.id} class:list={['section', 'stage', { 'section--cream': i % 2 === 0, 'stage--flip': i % 2 === 1 }]}>
          <div class="container stage__grid">
            <div class="stage__media">
              <div class="frame arch-3x4 stage__arch" data-reveal="clip">
                <Photo src={s.image.src} alt={s.image.alt} sizes="(max-width: 900px) 84vw, 460px" position={s.position} />
              </div>
              <div class="stage__moments">
                {s.moments.map((m, mi) => (
                  <div class="frame circle stage__moment" data-reveal="scale" style={`--d:${mi + 3}`}>
                    <Photo src={m.src} alt={m.alt} sizes="140px" />
                  </div>
                ))}
              </div>
            </div>
            <div class="stage__copy">
              <p class="stage__label" data-reveal>
                <span class="num">{s.num}</span>
                {s.stage}
              </p>
              <h2 class="stage__title" data-split>{s.title}<span class="full-stop">.</span></h2>
              <p class="t-h4 stage__lead" data-reveal style="--d:2">
                {s.lead}
              </p>
              <p class="t-muted" data-reveal style="--d:3">
                {s.body}
              </p>
              <div class="stage__points" data-reveal style="--d:4">
                <p class="stage__points-title">What your child will enjoy</p>
                <ul class="checklist">
                  {s.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              </div>
              <a href="/admissions#enquire" class="link-arrow" data-reveal style="--d:5">
                Enquire about {s.title} <Icon name="arrow-right" size={18} />
              </a>
            </div>
          </div>
        </section>
      ))
    }
  </div>

  <!-- ============ Principles ============ -->
  <section class="section section--night on-dark grain principles">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow" data-reveal>How we teach</p>
          <h2 class="t-h2" data-split>Four habits behind <em>every lesson</em><span class="full-stop">.</span></h2>
        </div>
        <p class="t-lead" data-reveal style="--d:2">
          Whatever the age or subject, you will find the same principles at work in every Karisbridge classroom.
        </p>
      </div>
      <ul class="principles__grid">
        {
          principles.map((p, i) => (
            <li class="principle" data-reveal style={`--d:${i}`}>
              <span class="principle__icon">
                <Icon name={p.icon} size={24} />
              </span>
              <h3 class="t-h4">{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ Enrichment ============ -->
  <section class="section enrichment" id="enrichment">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow" data-reveal>Enrichment</p>
        <h2 class="t-h2" data-split>Beyond the timetable, <em>into the world</em><span class="full-stop">.</span></h2>
        <p class="t-lead t-muted" data-reveal style="--d:2">
          Enrichment is woven through the week so that every child discovers new interests — and new strengths.
        </p>
      </div>
      <ul class="enrichment__grid">
        {
          enrichment.map((e, i) => (
            <li class="enrich" data-reveal style={`--d:${i % 2}`}>
              <div class="frame circle enrich__img">
                <Photo src={e.image.src} alt={e.image.alt} sizes="112px" />
              </div>
              <div class="enrich__body">
                <h3 class="t-h4">
                  <Icon name={e.icon} size={20} class="enrich__icon" />
                  {e.title}
                </h3>
                <p class="t-muted">{e.text}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ============ Summer school ============ -->
  <section class="section section--cream summer" id="summer-school">
    <div class="container summer__grid">
      <div class="summer__copy">
        <p class="eyebrow" data-reveal>KBS Summer School</p>
        <h2 class="t-h2" data-split>The long vacation, <em>well spent</em><span class="full-stop">.</span></h2>
        <p class="t-lead t-muted" data-reveal style="--d:2">
          During the long vacation, KBS Summer School keeps curiosity switched on with hands-on activities, creativity
          and play — a joyful way to keep learning while school is out.
        </p>
        <div class="btn-row" data-reveal style="--d:3">
          <a href="/admissions#enquire" class="btn btn--primary">
            Ask about this year’s dates
            <span class="btn__icon"><Icon name="arrow-up-right" size={18} /></span>
          </a>
        </div>
      </div>
      <div class="summer__media">
        <div class="frame summer__tile summer__tile--a" data-reveal="scale">
          <Photo src={media.summerSchool2024.src} alt={media.summerSchool2024.alt} sizes="206px" />
        </div>
        <div class="frame summer__tile summer__tile--b" data-reveal="scale" style="--d:2">
          <Photo src={media.youngChef.src} alt={media.youngChef.alt} sizes="206px" />
        </div>
        <div class="frame summer__tile summer__tile--c" data-reveal="scale" style="--d:3">
          <Photo src={media.codingLab.src} alt={media.codingLab.alt} sizes="206px" />
        </div>
        <div class="frame summer__tile summer__tile--d" data-reveal="scale" style="--d:4">
          <Photo src={media.littleScientist.src} alt={media.littleScientist.alt} sizes="206px" />
        </div>
        <span class="summer__badge" data-reveal="scale" style="--d:5">
          <Icon name="sun" size={26} />
        </span>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Jump nav ---------- */
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.4rem;
  }

  .jump a {
    padding: 0.55rem 1rem;
    border-radius: 999px;
    background: var(--white);
    box-shadow: inset 0 0 0 1px var(--line);
    font-size: 0.86rem;
    font-weight: 650;
    color: var(--ink);
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }

  .jump a:hover {
    background: var(--indigo);
    color: var(--white);
    box-shadow: none;
  }

  /* ---------- Stages ---------- */
  .stage__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(48px, 7vw, 120px);
    align-items: center;
  }

  .stage--flip .stage__media {
    order: 2;
  }

  .stage__media {
    position: relative;
    padding-bottom: 48px;
  }

  .stage__arch {
    width: min(100%, 460px);
    box-shadow: var(--shadow-lg);
  }

  .stage--flip .stage__arch {
    margin-left: auto;
  }

  .stage__moments {
    position: absolute;
    right: 0;
    bottom: 0;
    display: flex;
  }

  .stage--flip .stage__moments {
    right: auto;
    left: 0;
  }

  .stage__moment {
    width: clamp(104px, 10vw, 136px);
    box-shadow: 0 0 0 6px var(--paper);
  }

  .section--cream .stage__moment {
    box-shadow: 0 0 0 6px var(--cream);
  }

  .stage__moment + .stage__moment {
    margin-left: -22px;
  }

  .stage__copy {
    display: grid;
    gap: 1.3rem;
    justify-items: start;
  }

  .stage__label {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--indigo);
  }

  .stage__title {
    font-size: clamp(3.4rem, 1.8rem + 5vw, 6.6rem);
    font-weight: 330;
    line-height: 0.92;
    letter-spacing: -0.045em;
  }

  .stage__lead {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    color: var(--sky-ink);
  }

  .stage__points {
    width: 100%;
    margin: 0.6rem 0 0.4rem;
    padding: clamp(24px, 2.6vw, 32px);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .stage__points-title {
    margin-bottom: 1.1rem;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .stage__points .checklist {
    font-size: 0.97rem;
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .stage__grid {
      grid-template-columns: 1fr;
    }
    .stage--flip .stage__media {
      order: 0;
    }
    .stage__media {
      width: min(100%, 520px);
      margin-inline: auto;
    }
  }

  /* ---------- Principles ---------- */
  .principles__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
  }

  .principle {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    padding: clamp(28px, 3vw, 40px);
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.04);
    box-shadow: inset 0 0 0 1px var(--line-light);
    transition: background-color 0.5s var(--ease), transform 0.6s var(--ease-out);
  }

  .principle:hover {
    background: rgba(255, 255, 255, 0.08);
    transform: translateY(-4px);
  }

  .principle__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: 0.8rem;
    border-radius: 16px;
    background: rgba(14, 165, 236, 0.16);
    color: var(--sky);
  }

  @media (max-width: 1000px) {
    .principles__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .principles__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Enrichment ---------- */
  .enrichment__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(32px, 5vw, 80px);
  }

  .enrich {
    display: grid;
    grid-template-columns: 112px 1fr;
    gap: clamp(20px, 2.4vw, 32px);
    align-items: center;
    padding: clamp(24px, 2.6vw, 34px) 0;
    border-top: 1px solid var(--line-strong);
  }

  .enrich:nth-last-child(-n + 2) {
    border-bottom: 1px solid var(--line-strong);
  }

  .enrich__img {
    width: 112px;
    transition: transform 0.7s var(--ease-spring);
  }

  .enrich:hover .enrich__img {
    transform: rotate(-4deg) scale(1.04);
  }

  .enrich__body {
    display: grid;
    gap: 0.45rem;
  }

  .enrich__body h3 {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .enrich__icon {
    color: var(--sky-ink);
  }

  @media (max-width: 820px) {
    .enrichment__grid {
      grid-template-columns: 1fr;
    }
    .enrich:nth-last-child(2) {
      border-bottom: 0;
    }
  }

  @media (max-width: 460px) {
    .enrich {
      grid-template-columns: 84px 1fr;
      align-items: start;
    }
    .enrich__img {
      width: 84px;
    }
  }

  /* ---------- Summer school ---------- */
  .summer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(48px, 7vw, 120px);
    align-items: center;
  }

  .summer__copy {
    display: grid;
    gap: 1.6rem;
  }

  .summer__media {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 190px));
    gap: 18px;
    justify-content: center;
  }

  .summer__tile {
    aspect-ratio: 1;
    border-radius: 32px;
    box-shadow: var(--shadow);
  }

  /* independent rotate/translate so the reveal transform never overrides them */
  .summer__tile--a {
    rotate: -4deg;
  }

  .summer__tile--b {
    translate: 0 36px;
    rotate: 3deg;
  }

  .summer__tile--c {
    rotate: 2deg;
  }

  .summer__tile--d {
    translate: 0 36px;
    rotate: -3deg;
  }

  .summer__badge {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    margin: -20px 0 0 -38px;
    border-radius: 50%;
    background: var(--sun);
    color: var(--ink);
    box-shadow:
      0 0 0 8px var(--cream),
      var(--shadow);
  }

  @media (max-width: 900px) {
    .summer__grid {
      grid-template-columns: 1fr;
    }
    .summer__media {
      grid-template-columns: repeat(2, minmax(0, 170px));
      padding-bottom: 36px;
    }
  }
</style>
