---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import type { IconName } from '../components/Icon.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Email from '../components/Email.astro';
import { media } from '../data/media';
import { site, whatsappLink, mapsLink } from '../data/site';

const journey: { icon: IconName; title: string; text: string }[] = [
  { icon: 'mail', title: 'Enquire', text: 'Reach us on WhatsApp, by phone or through the form below. Tell us a little about your child.' },
  { icon: 'calendar', title: 'Visit', text: 'Book a personal tour. Meet our team, see the classrooms and ask anything at all.' },
  { icon: 'users', title: 'Meet', text: 'A relaxed, friendly interaction helps us understand your child and the right class for them.' },
  { icon: 'book', title: 'Register', text: 'Complete the registration form, submit your documents and confirm your child’s place.' },
  { icon: 'heart', title: 'Welcome', text: 'We help your child settle in gently, and keep you close every step of the way.' },
];

const documents = [
  'Completed registration form',
  'Copy of your child’s birth certificate',
  'Recent passport photographs of your child',
  'Immunisation record',
  'Most recent school report (for Primary entrants)',
];

const goodToKnow: { icon: IconName; title: string; text: string }[] = [
  { icon: 'clock', title: 'Visits by appointment', text: 'Monday to Friday — we will find a time that suits your family.' },
  { icon: 'book', title: 'Fees & schedules', text: 'Our current fee schedule is shared on request and during your visit.' },
  { icon: 'sun', title: 'Summer School', text: 'Ask us about KBS Summer School dates during the long vacation.' },
];

const faqs = [
  {
    q: 'Which classes does Karisbridge offer?',
    a: 'We offer Creche (babies and toddlers), Nursery (the early years) and Primary. Our admissions team will help you find the right class for your child’s age and stage.',
  },
  {
    q: 'Can I visit the school before applying?',
    a: 'Absolutely — we encourage it. Book a visit through WhatsApp, a phone call or the enquiry form, and we will arrange a personal tour at a convenient time.',
  },
  {
    q: 'Is there an assessment for new pupils?',
    a: 'For Nursery and Primary, we arrange a relaxed, friendly interaction so we can understand your child’s learning and settle them in the right class. It is never a stressful test.',
  },
  {
    q: 'Can my child join in the middle of the session?',
    a: 'Where space allows, yes. Please contact us for current availability in your child’s class.',
  },
  {
    q: 'How do I find out about school fees?',
    a: 'Our fee schedule is available on request. Send us a message or ask during your visit, and we will talk you through it.',
  },
  {
    q: 'Where exactly is the school?',
    a: `We are at ${site.address.street}, off the ${site.address.road}, ${site.address.area}, ${site.address.city}. Look for our ocean-themed shark entrance!`,
  },
];
---

<Base
  title="Admissions"
  description="Admissions at Karisbridge Schools, Ibeju-Lekki — book a school visit, see what to prepare and send an enquiry for Creche, Nursery or Primary."
  image={media.gradShapesTeacher.src}
>
  <PageHero
    crumb="Admissions"
    eyebrow="Admissions"
    lead="We welcome enquiries for Creche, Nursery and Primary. Our team will guide you through every step — warmly, clearly and at your pace."
    image={media.gradShapesTeacher}
    position="46% 50%"
  >
    <Fragment slot="title">Begin your child’s <em>Karisbridge</em> journey<span class="full-stop">.</span></Fragment>
    <div slot="actions" class="btn-row" data-reveal style="--d:4">
      <a href="#enquire" class="btn btn--primary">
        Make an enquiry
        <span class="btn__icon btn__icon--slide"><Icon name="arrow-right" size={18} /></span>
      </a>
      <a href={`tel:${site.phones[0].tel}`} class="btn btn--ghost">
        Call admissions
        <span class="btn__icon btn__icon--slide"><Icon name="phone" size={18} /></span>
      </a>
    </div>
  </PageHero>

  <!-- ============ Journey ============ -->
  <section class="section section--cream journey">
    <div class="container">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow" data-reveal>The admissions journey</p>
          <h2 class="t-h2" data-split>Five steps to a <em>warm welcome</em><span class="full-stop">.</span></h2>
        </div>
        <p class="t-lead t-muted" data-reveal style="--d:2">
          Joining a new school is a big moment for a family. We keep the process simple and personal, so you always
          know what comes next.
        </p>
      </div>
      <ol class="journey__list">
        {
          journey.map((j, i) => (
            <li class="journey__step" data-reveal style={`--d:${i}`}>
              <span class="journey__marker">
                <Icon name={j.icon} size={22} />
              </span>
              <span class="num">Step 0{i + 1}</span>
              <h3 class="t-h3">{j.title}</h3>
              <p class="t-muted t-small">{j.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ Prepare ============ -->
  <section class="section prepare">
    <div class="container prepare__grid">
      <div class="prepare__docs" data-reveal>
        <p class="eyebrow">What to prepare</p>
        <h2 class="t-h3">Documents for registration</h2>
        <ul class="checklist">
          {documents.map((d) => <li>{d}</li>)}
        </ul>
        <p class="t-small t-muted">Our admissions team will confirm the full list for your child’s class.</p>
      </div>
      <div class="prepare__know">
        <p class="eyebrow" data-reveal>Good to know</p>
        <ul class="prepare__list">
          {
            goodToKnow.map((g, i) => (
              <li data-reveal style={`--d:${i + 1}`}>
                <span class="icon-tile icon-tile--sun">
                  <Icon name={g.icon} size={22} />
                </span>
                <div>
                  <h3 class="t-h4">{g.title}</h3>
                  <p class="t-muted t-small">{g.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- ============ Enquiry ============ -->
  <section class="section section--cream enquire" id="enquire">
    <div class="container enquire__grid">
      <div class="enquire__intro">
        <p class="eyebrow" data-reveal>Enquire or book a visit</p>
        <h2 class="t-h2" data-split>Let’s <em>talk</em><span class="full-stop">.</span></h2>
        <p class="t-lead t-muted" data-reveal style="--d:2">
          Fill in the form and send it straight to our admissions team on WhatsApp or by email. Prefer to talk? We would
          love to hear from you.
        </p>
        <ul class="enquire__contacts" data-reveal style="--d:3">
          <li>
            <a href={whatsappLink('Hello Karisbridge Schools, I would like to make an admission enquiry.')} target="_blank" rel="noopener">
              <span class="icon-tile"><Icon name="whatsapp" size={22} /></span>
              <span><small>WhatsApp</small>Chat with admissions</span>
            </a>
          </li>
          {
            site.phones.map((p) => (
              <li>
                <a href={`tel:${p.tel}`}>
                  <span class="icon-tile">
                    <Icon name="phone" size={22} />
                  </span>
                  <span>
                    <small>Call</small>
                    {p.display}
                  </span>
                </a>
              </li>
            ))
          }
          <li>
            <a href={`mailto:${site.email}`}>
              <span class="icon-tile"><Icon name="mail" size={22} /></span>
              <span><small>Email</small><Email address={site.email} /></span>
            </a>
          </li>
          <li>
            <a href={mapsLink} target="_blank" rel="noopener">
              <span class="icon-tile"><Icon name="pin" size={22} /></span>
              <span><small>Visit</small>{site.address.street}, {site.address.area}</span>
            </a>
          </li>
        </ul>
      </div>
      <div class="enquire__card" data-reveal style="--d:2">
        <h3 class="t-h3">Admission enquiry</h3>
        <p class="t-muted t-small enquire__card-sub">It takes less than a minute.</p>
        <EnquiryForm />
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section faq">
    <div class="container faq__grid">
      <div class="faq__intro">
        <p class="eyebrow" data-reveal>Questions parents ask</p>
        <h2 class="t-h2" data-split>Good <em>questions</em><span class="full-stop">.</span></h2>
        <p class="t-muted" data-reveal style="--d:2">
          Can’t see yours? <a class="text-link" href="/contact">Get in touch</a> — we are happy to help.
        </p>
      </div>
      <div class="accordion" data-reveal style="--d:1">
        {
          faqs.map((f, i) => (
            <details open={i === 0}>
              <summary>
                {f.q}
                <span class="accordion__icon" aria-hidden="true">
                  <Icon name="plus" size={18} />
                </span>
              </summary>
              <div class="accordion__body">
                <p>{f.a}</p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Journey ---------- */
  .journey__list {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
  }

  .journey__list::before {
    content: '';
    position: absolute;
    top: 28px;
    left: 28px;
    right: 28px;
    height: 1px;
    background: repeating-linear-gradient(90deg, var(--line-strong) 0 6px, transparent 6px 12px);
  }

  .journey__step {
    position: relative;
    display: grid;
    gap: 0.7rem;
    align-content: start;
  }

  .journey__marker {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: 1rem;
    border-radius: 50%;
    background: var(--white);
    color: var(--indigo);
    box-shadow:
      0 0 0 8px var(--cream),
      var(--shadow-sm);
    transition: background-color 0.4s var(--ease), color 0.4s var(--ease), transform 0.6s var(--ease-spring);
  }

  .journey__step:hover .journey__marker {
    background: var(--indigo);
    color: var(--white);
    transform: scale(1.08);
  }

  @media (max-width: 1000px) {
    .journey__list {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .journey__list::before {
      top: 28px;
      bottom: 28px;
      left: 28px;
      right: auto;
      width: 1px;
      height: auto;
      background: repeating-linear-gradient(180deg, var(--line-strong) 0 6px, transparent 6px 12px);
    }
    .journey__step {
      grid-template-columns: 56px 1fr;
      column-gap: 1.4rem;
      row-gap: 0.3rem;
      padding-bottom: 2rem;
    }
    .journey__marker {
      grid-row: 1 / span 3;
      margin-bottom: 0;
    }
  }

  /* ---------- Prepare ---------- */
  .prepare__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }

  .prepare__docs {
    display: grid;
    gap: 1.4rem;
    padding: clamp(32px, 4vw, 56px);
    border-radius: var(--radius-xl);
    background: var(--white);
    box-shadow: inset 0 0 0 1px var(--line), var(--shadow);
  }

  .prepare__docs .checklist {
    margin: 0.4rem 0;
    color: var(--ink);
  }

  .prepare__know {
    display: grid;
    gap: 1.6rem;
    padding-top: clamp(0px, 2vw, 24px);
  }

  .prepare__list {
    display: grid;
  }

  .prepare__list li {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 1.2rem;
    align-items: center;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--line-strong);
  }

  .prepare__list li:first-child {
    border-top: 1px solid var(--line-strong);
  }

  .prepare__list h3 {
    margin-bottom: 0.2rem;
  }

  @media (max-width: 900px) {
    .prepare__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Enquire ---------- */
  .enquire__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .enquire__intro {
    position: sticky;
    top: calc(var(--header-h) + 32px);
    display: grid;
    gap: 1.6rem;
  }

  .enquire__contacts {
    display: grid;
    gap: 0.6rem;
    margin-top: 0.6rem;
  }

  .enquire__contacts a {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 1rem;
    align-items: center;
    padding: 0.7rem;
    border-radius: 20px;
    font-weight: 600;
    color: var(--ink);
    transition: background-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }

  .enquire__contacts a:hover {
    background: var(--white);
    box-shadow: var(--shadow-sm);
  }

  .enquire__contacts small {
    display: block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .enquire__card {
    padding: clamp(28px, 4vw, 56px);
    border-radius: var(--radius-xl);
    background: var(--white);
    box-shadow: inset 0 0 0 1px var(--line), var(--shadow-lg);
  }

  .enquire__card-sub {
    margin: 0.4rem 0 1.8rem;
  }

  @media (max-width: 960px) {
    .enquire__grid {
      grid-template-columns: 1fr;
    }
    .enquire__intro {
      position: static;
    }
  }

  /* ---------- FAQ ---------- */
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }

  .faq__intro {
    display: grid;
    gap: 1.4rem;
  }

  @media (max-width: 900px) {
    .faq__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
